    "fix-verifier": "hardhat run scripts/fix-verifier.cjs --network localhost",
    "fix-verifier:sepolia": "hardhat run scripts/fix-verifier.cjs --network sepolia",
    "mint-karrat": "hardhat run scripts/mint-karrat.cjs --network localhost",
    "mint-karrat:sepolia": "hardhat run scripts/mint-karrat.cjs --network sepolia",
    "mint-to": "hardhat run scripts/mint-to-address.cjs --network localhost",
    "mint-to:sepolia": "hardhat run scripts/mint-to-address.cjs --network sepolia",
    "server": "json-server --watch db.json --port 3001"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "hardhat": "^2.19.0",
    "json-server": "^0.17.4",
    "vite": "^5.0.0"
  }
