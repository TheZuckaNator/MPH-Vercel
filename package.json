{
  "name": "mph-nft-store",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "node": "hardhat node",
    "compile": "hardhat compile",
